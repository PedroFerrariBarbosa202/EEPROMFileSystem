#==============================================================================
# EEFS STM32 Example
#==============================================================================

PREFIX ?= arm-none-eabi-

CC      := $(PREFIX)gcc
AR      := $(PREFIX)ar
OBJCOPY := $(PREFIX)objcopy

OPENCM3_DIR := ../../../libopencm3
EEFS_DIR    := ../..

LIBNAME := opencm3_stm32f4
BINARY  := firmware

#------------------------------------------------------------------------------
# Includes
#------------------------------------------------------------------------------

CPPFLAGS := \
    -DSTM32F4 \
    -I$(EEFS_DIR)/include \
    -I$(EEFS_DIR)/drivers/inc \
    -I$(EEFS_DIR)/system \
    -I$(EEFS_DIR)/system/syslog \
    -I$(OPENCM3_DIR)/include

#------------------------------------------------------------------------------
# Architecture
#------------------------------------------------------------------------------

ARCH_FLAGS := \
    -mthumb \
    -mcpu=cortex-m4 \
    -mfloat-abi=hard \
    -mfpu=fpv4-sp-d16

#------------------------------------------------------------------------------
# Compiler
#------------------------------------------------------------------------------

CFLAGS := \
    $(ARCH_FLAGS) \
    -O2 \
    -g \
    -std=c99 \
    -Wall \
    -Wextra \
    -Wshadow \
    -Wundef \
    -Wimplicit-function-declaration \
    -Wredundant-decls \
    -Wmissing-prototypes \
    -Wstrict-prototypes \
    -fno-common \
    -ffunction-sections \
    -fdata-sections

#------------------------------------------------------------------------------
# Sources
#------------------------------------------------------------------------------

SRC := firmware.c
OBJ := $(SRC:.c=.o)

#------------------------------------------------------------------------------
# Linker
#------------------------------------------------------------------------------

LDFLAGS := \
    --static \
    -nostartfiles \
    $(ARCH_FLAGS) \
    -Tlinkerscript.ld \
    -L$(OPENCM3_DIR)/lib \
    -L$(EEFS_DIR)/lib \
    -Wl,--gc-sections

LDLIBS := \
    -leefs \
    -l$(LIBNAME) \
    -Wl,--start-group \
    -lc \
    -lgcc \
    -lnosys \
    -Wl,--end-group

#------------------------------------------------------------------------------
# Targets
#------------------------------------------------------------------------------

.PHONY: all clean eefs

all: $(BINARY).bin

#------------------------------------------------------------------------------
# Firmware
#------------------------------------------------------------------------------

$(BINARY).elf: $(OBJ) eefs
	$(CC) $(LDFLAGS) $(OBJ) $(LDLIBS) -o $@

$(BINARY).bin: $(BINARY).elf
	$(OBJCOPY) -Obinary $< $@

#------------------------------------------------------------------------------
# EEFS
#------------------------------------------------------------------------------

eefs:
	$(MAKE) -C $(EEFS_DIR) clean
	$(MAKE) -C $(EEFS_DIR) \
		CC=$(CC) \
		AR=$(AR) \
		CFLAGS="$(CFLAGS)"
#------------------------------------------------------------------------------
# Compilation
#------------------------------------------------------------------------------

%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

#------------------------------------------------------------------------------
# Clean
#------------------------------------------------------------------------------

clean:
	rm -f $(OBJ)
	rm -f $(BINARY).elf
	rm -f $(BINARY).bin
	$(MAKE) -C $(EEFS_DIR) clean
